{
  "name": "figctx",
  "version": "0.1.0",
  "description": "Local Figma .fig context extraction and MCP server for coding agents",
  "type": "module",
  "bin": {
    "figctx": "./dist/main.js",
    "figctx-mcp": "./dist/mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/symonbaikov/figma-free-mcp.git"
  },
  "homepage": "https://github.com/symonbaikov/figma-free-mcp#readme",
  "bugs": {
    "url": "https://github.com/symonbaikov/figma-free-mcp/issues"
  },
  "keywords": [
    "figma",
    "mcp",
    "design-to-code",
    "local-first",
    "coding-agents"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/bundle.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "commander": "^13.1.0",
    "fontkit": "^2.0.4",
    "fzstd": "0.1.1",
    "kiwi-schema": "0.5.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.9",
    "@figctx/core": "workspace:*",
    "esbuild": "0.28.1"
  }
}
